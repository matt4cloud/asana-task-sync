# Copy this file next to one task-control JSON as NAME_TASK_CONTROL.env.
# Fill every required target value for that exact JSON instance. No token belongs here.
ASANA_PROJECT_NAME=
ASANA_PROJECT_GID=
ASANA_TITLE_PREFIX=""
# Required for validate, pull, and push: the sibling JSON file for this instance.
ASANA_STATE_FILE=
# Optional paired fallback used only while creating a new task with no own
# asana.assignee_gid. It never filters imports or overwrites an existing task.
ASANA_NEW_TASK_DEFAULT_ASSIGNEE_GID=
ASANA_NEW_TASK_DEFAULT_ASSIGNEE_EMAIL=
